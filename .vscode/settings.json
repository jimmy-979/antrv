{
  // Format on save for all files
  "editor.formatOnSave": true,
  // Python settings
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  // Verilog settings
  "verilog.formatting.veribleVerilogFormatter.path": "verible-verilog-format",
  "verilog.linting.linter": "verible-verilog-lint",
  "verilog.linting.veribleVerilogLint.runAtFileLocation": false,
  // Exclude files
  "files.exclude": {
    "**/.git": true,
    "**/__pycache__": true
  },
  // C settings
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/hal/build/c-header"
  ]
}
